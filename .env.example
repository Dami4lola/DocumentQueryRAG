# Server-side keys. Copy to .env.local for local development,
# and add the same variables in Vercel → Project → Settings → Environment Variables.
OPENAI_API_KEY=your-openai-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index-name

# Signs document session tokens. Optional locally (derived from PINECONE_API_KEY if unset),
# recommended in production. Generate one with: openssl rand -hex 32
SESSION_SECRET=
